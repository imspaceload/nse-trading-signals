[Unit]
Description=NSE Trading API (FastAPI)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/nse-trading-signals/backend
ExecStart=/root/nse-trading-signals/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
EnvironmentFile=/root/nse-trading-signals/.env

[Install]
WantedBy=multi-user.target
